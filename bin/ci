#!/usr/bin/env python3
"""
Local CI: every suite in its own container, in parallel.

Usage:
    bin/ci           Run every suite
    bin/ci --staged  Run only the suites the staged paths reach (the pre-commit hook)
    bin/ci --fix     Let the linters fix what they can (oxfmt in the TypeScript suite, ruff over bin/tests and digest/python)
"""

import os
import subprocess
import sys
import time
from concurrent.futures import ThreadPoolExecutor
from pathlib import Path

TS, WORKER, SCRIPTS = "ts", "worker", "scripts"
ALL_SUITES = frozenset({TS, WORKER, SCRIPTS})

# A path narrows the run only when it clearly belongs to one suite's inputs; every other path runs
# everything. First match wins, so the shared paths sit above the prefixes that would claim them.
# test_ci_scope.py holds this table to the COPY lists that define each container.
_SCOPE: tuple[tuple[str, frozenset[str]], ...] = (
    ("digest/package-lock.json", frozenset({TS})),
    ("digest/python/pyproject.toml", frozenset({WORKER, TS, SCRIPTS})),
    # The ci-ts image COPYs all of digest/, python/ included; ci-scripts runs ruff over it.
    ("digest/python/", frozenset({WORKER, TS, SCRIPTS})),
    # bin/ops's Postgres payloads: executed in ci-ts, and read by bin/tests/test_ops.py.
    ("digest/db/ops/", frozenset({TS, SCRIPTS})),
    ("digest/", frozenset({TS})),
    # The operator scripts' own tests; the scripts they test sit in bin/ and so reach everything.
    ("bin/tests/", frozenset({SCRIPTS})),
)


def suites_for(paths: list[str]) -> frozenset[str]:
    """The suites a set of changed paths reaches. A path no rule claims reaches every suite."""
    suites: set[str] = set()
    for path in paths:
        # Container definitions are what test_ci_scope.py reads to check this table, so a change
        # to any of them must run that test (the scripts suite) as well as the suite it builds.
        name = path.rsplit("/", 1)[-1]
        if name.startswith("Dockerfile") or name == ".dockerignore" or (
            name.startswith("docker-compose") and name.endswith((".yml", ".yaml"))
        ):
            return ALL_SUITES
        for prefix, owners in _SCOPE:
            if path == prefix or (prefix.endswith("/") and path.startswith(prefix)):
                suites |= owners
                break
        else:
            return ALL_SUITES
    return frozenset(suites)


def staged_paths() -> list[str] | None:
    """Both sides of every staged change (renames split), or None when git cannot say."""
    result = subprocess.run(
        ["git", "diff", "--cached", "--name-only", "--no-renames", "-z"],
        cwd=ROOT,
        capture_output=True,
    )
    if result.returncode != 0:
        return None
    return [p for p in result.stdout.decode().split("\0") if p]

# ANSI color codes
PURPLE = "\033[35m"
GREEN = "\033[32m"
RED = "\033[31m"
YELLOW = "\033[33m"
BOLD = "\033[1m"
RESET = "\033[0m"

ROOT = Path(__file__).resolve().parent.parent
QUIET = os.environ.get("CLAUDECODE") == "1"


def suite_commands(fix_mode: bool, staged: bool = False) -> dict[str, list[str]]:
    """The docker compose command each suite runs as, keyed by suite. A staged run (the pre-commit
    hook) leaves out the Temporal-server tests; a full run (pre-push, GitHub CI) has them."""
    return {
        # ci-ts COPYs digest/ in; under --fix, src is mounted so the formatter writes back.
        TS: ["docker", "compose", "run", "--rm", "--build"]
        + (["-v", f"{ROOT}/digest/src:/app/digest/src"] if fix_mode else [])
        + ["ci-ts", "sh", "-c", ts_cmd(fix_mode, staged)],
        WORKER: [
            "docker", "compose", "run", "--rm", "--build", "ci-python",
            "python", "-m", "pytest", "-q", "-n", "auto", "-p", "no:cacheprovider", "/app/tests",
        ],
        SCRIPTS: ["docker", "compose", "run", "--rm", "--build", "ci-scripts", "sh", "-c", scripts_cmd(fix_mode)],
    }


def scripts_cmd(fix_mode: bool) -> str:
    """ruff over bin/tests and digest/python (ruff.toml), then pytest over bin/tests; every step
    runs, so one failure hides no other."""
    py = "bin/tests digest/python"
    if fix_mode:
        lint = f"ruff check --fix {py}; r=$?; ruff format {py}; f=$?"
    else:
        lint = f"ruff check {py}; r=$?; ruff format --check {py}; f=$?"
    return f"{lint}; pytest -q -n auto -p no:cacheprovider bin/tests; t=$?; [ $r -eq 0 ] && [ $f -eq 0 ] && [ $t -eq 0 ]"


def ts_cmd(fix_mode: bool, staged: bool = False) -> str:
    """Format, typecheck and lint (about 1 s together), then vitest; every step runs, so one failure
    hides no other. A tsgolint killed for memory shows only "Error running tsgolint"."""
    fmt = "npm run format; f=$?" if fix_mode else "npm run format:check; f=$?"
    test = "npm test -- --project unit" if staged else "npm test"
    return (
        f"{fmt}; npm run typecheck; t=$?; npm run lint; l=$?; {test}; v=$?; "
        "[ $f -eq 0 ] && [ $t -eq 0 ] && [ $l -eq 0 ] && [ $v -eq 0 ]"
    )


SUITE_NAMES = {
    TS: "TypeScript CI",
    WORKER: "Python worker CI",
    SCRIPTS: "bin/ scripts CI",
}


def run_in_docker() -> int:
    """Run CI via docker compose, one container per suite, all in parallel."""
    args = sys.argv[1:]
    fix_mode = "--fix" in args

    suites = ALL_SUITES
    if "--staged" in args:
        paths = staged_paths()
        suites = ALL_SUITES if paths is None else suites_for(paths)
    if not suites:
        print(f"{GREEN}No staged paths reach a suite; nothing to check{RESET}")
        return 0
    skipped = sorted(ALL_SUITES - suites)
    print(f"{BOLD}{PURPLE}Running CI in Docker: {', '.join(sorted(suites))}{RESET}")
    if skipped:
        print(f"{YELLOW}Not reached by the staged paths: {', '.join(skipped)}{RESET}")
    print()

    # In quiet mode, capture output and only show on failure
    capture = {"stdout": subprocess.PIPE, "stderr": subprocess.STDOUT} if QUIET else {}
    commands = suite_commands(fix_mode, staged="--staged" in args)
    start = time.monotonic()
    procs = {s: subprocess.Popen(commands[s], cwd=ROOT, **capture) for s in sorted(suites)}

    def wait(suite: str) -> tuple[bytes | None, float]:
        out = procs[suite].communicate()[0]
        return out, time.monotonic() - start

    with ThreadPoolExecutor(len(procs)) as pool:
        results = dict(zip(procs, pool.map(wait, procs)))

    for suite, (out, secs) in results.items():
        code = procs[suite].returncode
        print(f"  {SUITE_NAMES[suite]}: exit {code} in {secs:.0f}s")
        if code != 0:
            print(f"\n{RED}{SUITE_NAMES[suite]} failed (exit {code}){RESET}")
            if out:
                print(out.decode(errors="replace"))

    failed = [p.returncode for p in procs.values() if p.returncode != 0]
    if not failed and QUIET:
        print(f"{GREEN}CI passed{RESET}")
    return failed[0] if failed else 0


def main() -> int:
    return run_in_docker()


if __name__ == "__main__":
    sys.exit(main())
