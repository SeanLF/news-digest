#!/usr/bin/env python3
"""Replays model stages of stored runs, in parallel, each in its own scratch copy of the product database.

A plan file has one replay per line:

    MODE LABEL RUN [STAGE.KEY=VALUE ...]

    select     high1     319  select.effort=high
    coherence  haiku313  313  coherence.model=claude-haiku-5-5
    cluster    base1     319

MODE is cluster, select, coherence or attribute (digest/src/gate/stage-replay.ts, run by digest/src/cli/stage-replay.ts). Each line gets the
repo's digest/agents with its overrides applied to the named stage files' frontmatter, a fresh
database copied from --template (default digest_clone, from make db-clone), and one worker container;
its result lands in OUT/MODE-LABEL.json and a line that already has one is skipped, so a plan resumes.

Replays run in parallel, bounded by model calls in flight (--calls, default 4: what the subscription is
known to tolerate, digest/src/workflow/bounded.ts). A cluster replay holds MODEL_FANOUT_LIMIT slots,
the others one. Usage: bin/replay PLAN [--out DIR] [--calls N] [--template DB] [--no-build] [--dry-run]
"""

import argparse
import re
import shutil
import subprocess
import sys
import threading
from concurrent.futures import ThreadPoolExecutor
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
DATA = ROOT / "data"
MODES = ("cluster", "select", "coherence", "attribute")
CLUSTER_FANOUT = 4  # MODEL_FANOUT_LIMIT in digest/src/workflow/bounded.ts
LINE = re.compile(r"^(\w+)\s+([A-Za-z0-9_-]+)\s+(\d+)((?:\s+[\w-]+\.\w+=\S+)*)\s*$")


class PlanError(ValueError):
    pass


def parse_plan(text):
    """Plan lines to dicts; '#' comments and blank lines are skipped. Labels must be unique."""
    plan, seen = [], set()
    for n, raw in enumerate(text.splitlines(), 1):
        line = raw.split("#", 1)[0].strip()
        if not line:
            continue
        m = LINE.match(line)
        if not m:
            raise PlanError(
                f"line {n}: expected MODE LABEL RUN [stage.key=value ...]: {raw!r}"
            )
        mode, label, run, rest = m.groups()
        if mode not in MODES:
            raise PlanError(f"line {n}: mode {mode!r} is not one of {', '.join(MODES)}")
        if label in seen:
            raise PlanError(f"line {n}: label {label!r} repeats")
        seen.add(label)
        overrides = {}
        for item in rest.split():
            key, value = item.split("=", 1)
            stage, field = key.split(".", 1)
            overrides.setdefault(stage, {})[field] = value
        plan.append(
            {"mode": mode, "label": label, "run": int(run), "overrides": overrides}
        )
    return plan


def set_frontmatter(md, field, value):
    """Sets `field: value` in an agent file's frontmatter, replacing it or adding it before the close."""
    if not md.startswith("---\n") or "\n---\n" not in md[3:]:
        raise PlanError("agent file has no frontmatter")
    head, body = md[4:].split("\n---\n", 1)
    lines = head.split("\n")
    for i, l in enumerate(lines):
        if l.split(":", 1)[0].strip() == field:
            lines[i] = f"{field}: {value}"
            break
    else:
        lines.append(f"{field}: {value}")
    return "---\n" + "\n".join(lines) + "\n---\n" + body


def build_agents(src, dest, overrides):
    """A copy of the agents directory with each stage's overrides applied; refuses an unknown stage."""
    if dest.exists():
        shutil.rmtree(dest)
    shutil.copytree(src, dest)
    for stage, fields in overrides.items():
        f = dest / f"{stage}.md"
        if not f.exists():
            raise PlanError(f"no agent file for stage {stage!r}")
        md = f.read_text()
        for field, value in fields.items():
            md = set_frontmatter(md, field, value)
        f.write_text(md)


def slots(mode):
    return CLUSTER_FANOUT if mode == "cluster" else 1


class Slots:
    """A counting gate that takes all of a replay's slots at once, so two wide replays cannot deadlock."""

    def __init__(self, n):
        self.free, self.cond = n, threading.Condition()

    def take(self, k):
        with self.cond:
            self.cond.wait_for(lambda: self.free >= k)
            self.free -= k

    def give(self, k):
        with self.cond:
            self.free += k
            self.cond.notify_all()


def container_path(p):
    return "/app/data/" + str(p.resolve().relative_to(DATA.resolve()))


def run_one(item, out, template, compose, dry, log):
    db = f"replay_{out.name}_{item['label']}".lower().replace("-", "_")[:63]
    result = out / f"{item['mode']}-{item['label']}.json"
    agents = out / "agents" / item["label"]
    psql = [
        *compose,
        "exec",
        "-T",
        "digest-pg",
        "psql",
        "-q",
        "-U",
        "postgres",
        "-v",
        "ON_ERROR_STOP=1",
    ]
    run = [
        *compose,
        "run",
        "-T",
        "--rm",
        "--no-deps",
        "-e",
        f"DIGEST_DATABASE_URL=postgres://postgres:digest@digest-pg:5432/{db}?sslmode=disable",
        "-e",
        f"RUN={item['run']}",
        "-e",
        f"AGENTS_DIR={container_path(agents)}",
        "digest-worker",
        "node",
        "dist/cli/stage-replay.js",
        item["mode"],
        container_path(result),
    ]
    steps = [
        [
            *psql,
            "-c",
            f"DROP DATABASE IF EXISTS {db}",
            "-c",
            f"CREATE DATABASE {db} TEMPLATE {template}",
        ],
        run,
    ]
    drop = [*psql, "-c", f"DROP DATABASE IF EXISTS {db} WITH (FORCE)"]
    if dry:
        log(f"{item['label']}: " + " && ".join(" ".join(s) for s in steps))
        return True
    build_agents(ROOT / "digest" / "agents", agents, item["overrides"])
    try:
        for s in steps:
            p = subprocess.run(
                s,
                stdin=subprocess.DEVNULL,
                capture_output=True,
                text=True,
                cwd=ROOT,
                check=False,
            )
            if p.returncode != 0:
                log(
                    f"FAILED {item['label']}: {(p.stderr or p.stdout).strip().splitlines()[-1:]}"
                )
                return False
        log(
            p.stdout.strip().splitlines()[-1]
            if p.stdout.strip()
            else f"{item['label']}: done"
        )
        return True
    finally:
        subprocess.run(
            drop, stdin=subprocess.DEVNULL, capture_output=True, cwd=ROOT, check=False
        )


def main(argv=None):
    ap = argparse.ArgumentParser(
        description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter
    )
    ap.add_argument("plan", type=Path)
    ap.add_argument(
        "--out",
        type=Path,
        help="results directory under data/ (default data/replay/<plan name>)",
    )
    ap.add_argument(
        "--calls",
        type=int,
        default=4,
        help="model calls in flight across all replays (default 4)",
    )
    ap.add_argument(
        "--template",
        default="digest_clone",
        help="database each replay copies (default digest_clone)",
    )
    ap.add_argument(
        "--no-build", action="store_true", help="skip rebuilding the worker image"
    )
    ap.add_argument("--dry-run", action="store_true")
    a = ap.parse_args(argv)
    plan = parse_plan(a.plan.read_text())
    out = (a.out or DATA / "replay" / a.plan.stem).resolve()
    if not out.is_relative_to(DATA.resolve()):
        raise PlanError(f"--out must be under {DATA} (the worker sees only data/)")
    if a.calls < CLUSTER_FANOUT and any(i["mode"] == "cluster" for i in plan):
        raise PlanError(
            f"a cluster replay needs {CLUSTER_FANOUT} call slots; --calls is {a.calls}"
        )
    out.mkdir(parents=True, exist_ok=True)
    todo = [i for i in plan if not (out / f"{i['mode']}-{i['label']}.json").exists()]
    lock = threading.Lock()

    def log(msg):
        with lock:
            print(msg, flush=True)

    log(
        f"{len(plan) - len(todo)} done, {len(todo)} to run, {a.calls} calls in flight -> {out}"
    )
    compose = ["docker", "compose"]
    if todo and not a.dry_run and not a.no_build:
        subprocess.run(
            [*compose, "build", "-q", "digest-worker"],
            check=True,
            cwd=ROOT,
            stdin=subprocess.DEVNULL,
        )
    gate = Slots(a.calls)

    def job(item):
        k = slots(item["mode"])
        gate.take(k)
        try:
            return run_one(item, out, a.template, compose, a.dry_run, log)
        finally:
            gate.give(k)

    with ThreadPoolExecutor(max_workers=max(1, a.calls)) as pool:
        ok = list(pool.map(job, todo))
    failed = ok.count(False)
    log(f"{len(ok) - failed} ok, {failed} failed")
    return 1 if failed else 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except PlanError as e:
        sys.exit(f"bin/replay: {e}")
