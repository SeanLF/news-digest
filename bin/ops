#!/usr/bin/env python3
"""Read-only operator queries against the production digest, over the SSH channel we already have.

Reviewing a run used to mean cloning a 176 MB database over Tailscale and grepping journalctl
by hand. This runs the query on the box instead and prints JSON, so nothing is copied and
nothing is stale.

Two independent read-only guarantees, because production data is under this:
  1. psql logs in as digest_ro, which holds SELECT and nothing else (digest/db/ops/digest_ro.sql);
  2. the session is read-only (PGOPTIONS default_transaction_read_only=on), so it refuses a write
     even from a role that may write.
Tests assert both, and that no payload carries a write verb or a SET that could turn the session
writable; digest/src/ops/ops-payloads.test.ts runs the payloads against a real server and shows
each guarantee refusing a write with the other absent. The output is compact JSON; pipe it to jq.

Deliberately NOT an HTTP surface. The site sits behind kamal-proxy on an internal Docker
network and never sees a client address, so "Tailscale-only routes" there could only mean
trusting an X-Forwarded-For header -- an authorisation boundary made of a header a caller
controls. See docs/2026-09-03-ops-access-review.md. The channel here is SSH over Tailscale,
which authenticates the device and grants this operator nothing they did not already have.

Usage:
  bin/ops run [ID]                 one run's row (default: the latest)
  bin/ops usage [ID]               per-stage tokens and API-equivalent cost
  bin/ops health [ID]              per-source fetch results, failures first
  bin/ops artifacts [ID]           the archived artifact names and their sizes
  bin/ops artifact ID NAME         one artifact's content, to stdout
  bin/ops journal [--service worker|python|site] [--since 1h] [--lines 200] [--grep PAT]
  ... any subcommand with --print-command to see what would run, and run nothing.
"""

from __future__ import annotations

import argparse
import re
import shlex
import subprocess
import sys
from pathlib import Path

# The product database in the Postgres Temporal runs (seanfloyd-infra tofu/news-digest-temporal.tf),
# reached over the container's local socket.
PG_CONTAINER = "news-digest-temporal-postgres"
PG_ROLE = "digest_ro"
PG_DATABASE = "digest"
# Kamal names a container <service>-<role>-<version>. Only the running one has logs here; older
# versions' logs, and every container's, are in PostHog Logs (seanfloyd-infra tofu/news-digest-logs.tf).
LOG_CONTAINERS = {"worker": "digest-worker-worker-", "python": "digest-python-worker-", "site": "digest-site-web-"}
PG_READ_ONLY = "-c default_transaction_read_only=on"
PAYLOAD_DIR = Path(__file__).resolve().parent.parent / "digest" / "db" / "ops"


# One psql script per subcommand, each a SELECT. The run id and the artifact name arrive as bound
# parameters from the environment, never as SQL text, so a caller-supplied name cannot become SQL.
SQL_SUBCOMMANDS = ("run", "usage", "health", "artifacts", "artifact")


def build_payload(sub: str) -> str:
    """What runs on the box: the psql script for the subcommand.

    The run id and the artifact name are NOT arguments here: they reach the database as bound
    parameters read from the environment inside the container, so no caller-supplied string
    ever enters SQL text.
    """
    if sub not in SQL_SUBCOMMANDS:
        raise KeyError(sub)
    return (PAYLOAD_DIR / f"{sub}.sql").read_text()


def remote_command(env: dict[str, str] | None = None) -> str:
    """The shell command sent over bin/ssh: psql in the database's own container reads the payload
    from stdin. Every variable is passed even when empty: psql's \\getenv leaves an unset one unset,
    and \\bind then sends the literal text ':rid'."""
    flags = "".join(f" -e {k}={shlex.quote(v)}" for k, v in sorted((env or {}).items()))
    return (
        f"set -e; docker exec -i{flags} -e PGOPTIONS={shlex.quote(PG_READ_ONLY)} {PG_CONTAINER} "
        f"psql -X -q -v ON_ERROR_STOP=1 -U {PG_ROLE} -d {PG_DATABASE} -f -"
    )


def _docker_since(since: str) -> str:
    """`4d` -> `96h`: docker logs takes Go durations, which have no days or weeks, or a timestamp
    with a T."""
    stripped = since.strip()
    m = re.fullmatch(r"(\d+)([smhdw])", stripped)
    if m and m[2] in "dw":
        return f"{int(m[1]) * (24 if m[2] == 'd' else 168)}h"
    return stripped.replace(" ", "T")


def journal_command(since: str, lines: int, grep: str | None, service: str = "worker") -> str:
    """The running container's log, bounded by --lines on purpose.

    These logs carry email addresses (alert recipients), which is acceptable on a channel the
    operator already has and the reason this must never become an HTTP tool.

    grep -E runs before tail: tail first would drop a match older than the last N raw lines of
    the window, and plain grep would read `ERROR|Traceback` as a literal. No running container
    is an error, not an empty log.
    """
    prefix = LOG_CONTAINERS[service]
    filtered = f" | {{ grep -E -- {shlex.quote(grep)} || [ $? -eq 1 ]; }}" if grep else ""
    return (
        f"set -o pipefail; c=$(docker ps -q --filter name=^{prefix} | head -1); "
        f'[ -n "$c" ] || {{ echo "no running {prefix}* container" >&2; exit 3; }}; '
        f'docker logs -t --since {shlex.quote(_docker_since(since))} "$c" 2>&1{filtered} | tail -n {int(lines)}'
    )


def _ssh(command: str, stdin: str | None) -> int:
    ssh = Path(__file__).resolve().parent / "ssh"
    proc = subprocess.run(
        [str(ssh), command],
        input=stdin,
        text=True,
        check=False,
    )
    return proc.returncode


def main(argv: list[str] | None = None) -> int:
    ap = argparse.ArgumentParser(prog="bin/ops", description=__doc__.split("\n")[0])
    ap.add_argument("subcommand", choices=[*SQL_SUBCOMMANDS, "journal"])
    ap.add_argument("args", nargs="*", help="run id, and the artifact name for `artifact`")
    ap.add_argument("--since", default="1h", help="journal only (default 1h)")
    ap.add_argument("--lines", type=int, default=200, help="journal only (default 200)")
    ap.add_argument("--grep", default=None, help="journal only (grep -E)")
    ap.add_argument("--service", default="worker", choices=sorted(LOG_CONTAINERS), help="journal only (default worker)")
    ap.add_argument("--print-command", action="store_true", help="show what would run; run nothing")
    ns = ap.parse_args(argv)

    # Silently discarding an extra argument hides an operator typo behind a result that looks
    # right, so every subcommand is bounded -- journal included, which takes none at all.
    expected = 0 if ns.subcommand == "journal" else (2 if ns.subcommand == "artifact" else 1)
    if len(ns.args) > expected:
        ap.error(f"{ns.subcommand} takes at most {expected} argument(s), got {len(ns.args)}")

    if ns.subcommand == "journal":
        command, payload = journal_command(ns.since, ns.lines, ns.grep, ns.service), None
    else:
        run_id = ns.args[0] if ns.args else ""
        name = ns.args[1] if len(ns.args) > 1 else ""
        if run_id and not run_id.isdigit():
            ap.error(f"a run id is a number, got {run_id!r}")
        if ns.subcommand == "artifact" and not name:
            ap.error("artifact needs a run id and an artifact name")
        payload = build_payload(ns.subcommand)
        command = remote_command({"OPS_RUN": run_id, "OPS_NAME": name})

    if ns.print_command:
        print(command)
        if payload:
            print("--- stdin ---")
            print(payload, end="")
        return 0
    return _ssh(command, payload)


if __name__ == "__main__":
    sys.exit(main())
